{
  "redirects": [{ "source": "/panel", "destination": "/panel/", "permanent": true }],
  "rewrites": [{ "source": "/((?!frames/|models/|assets/|panel/).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/frames/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
