# Apps Script web uygulamasının "/exec" ile biten dağıtım adresi.
VITE_BASVURU_ENDPOINT="https://script.google.com/macros/s/AKfycb.../exec"

# apps-script/Kod.gs içindeki GIZLI_ANAHTAR ile birebir aynı olmalı.
# Not: bu değer derlemeye gömülür, yani tarayıcıdan okunabilir. Amacı
# uç noktayı rastgele tarayan botları elemek; gerçek bir sır değildir.
VITE_BASVURU_ANAHTARI="uzun-rastgele-bir-dize"

# Takım paneli (/panel/) — Firebase konsolu → Proje ayarları → Web uygulaması → firebaseConfig.
# Bunlar da derlemeye gömülür ve gizli değildir; veriyi firestore.rules korur.
# Boş bırakılırsa panel "yerel modda" açılır (kayıtlar yalnız o tarayıcıda kalır).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="voltaris-xxxx.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="voltaris-xxxx"
VITE_FIREBASE_APP_ID=""

# Yerelde Firebase emülatörüyle denemek için 1 yap (firebase emulators:start).
VITE_FIREBASE_EMULATOR=""
